{
  "name": "vscode-extension-static-ui-sample",
  "displayName": "vscode-extension-static-ui-sample",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "マイ拡張機能の設定",
      "preLaunchTask": null,
      "properties": {
        "myExtension.enabled": {
          "type": "boolean",
          "default": true,
          "description": "機能を有効にするかどうかを指定します。"
        },
        "myExtension.mode": {
          "type": "string",
          "default": "fast",
          "enum": ["fast", "slow", "auto"],
          "enumDescriptions": [
            "高速モードで動作します",
            "低速モードで動作します",
            "自動で切り替えます"
          ],
          "description": "動作モードを選択します。"
        },
        "myExtension.apiKey": {
          "type": "string",
          "default": "",
          "description": "APIキーを入力してください。"
        },
        "myExtension.tax": {
          "type": "number",
          "default": 0.1
        },
        "myExtension.count": {
          "type": "integer",
          "default": 1
        },
        "myExtension.nullishItem": {
          "type": "null"
        },
        "myExtension.enabledDays": {
          "type": "array",
          "description": "",
          "items": {
            "type": "string",
            "enum": ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"],
            "maxItems": 7
          }
        }
      }
    }
  },
  "scripts": {},
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
